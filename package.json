{
  "name": "pi-keep-head-compaction",
  "version": "0.1.0",
  "description": "Pi coding agent extension: keep the first N tokens of the conversation verbatim (in addition to the recent tail) when compaction summarizes the middle",
  "license": "MIT",
  "author": "Nelson Pascoal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foomip/pi-keep-head-compaction.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "compaction",
    "context"
  ],
  "type": "module",
  "main": "./extensions/keep-head-compaction.ts",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": ["./extensions/keep-head-compaction.ts"]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-coverage-exclude='**/node_modules/**' test/*.test.ts",
    "coverage": "node scripts/coverage-badges.mjs --out coverage/badges --coverage-dir coverage/report.txt"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=26"
  }
}
